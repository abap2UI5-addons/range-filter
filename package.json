{
  "name": "abap2ui5-range-filter",
  "private": true,
  "version": "1.0.0",
  "description": "Select-options with saved variants for abap2UI5 apps - generated from a table name or your data.",
  "scripts": {
    "syfixes": "find . -type f -name '*.abap' -exec sed -i -e 's/ RAISE EXCEPTION TYPE cx_sy_itab_line_not_found/ ASSERT 1 = 0/g' {} + ",
    "rename": "abaplint .github/abaplint/rename.json --rename",
    "lint": "abaplint ./abaplint.jsonc",
    "check:cloud": "abaplint .github/abaplint/abap_cloud.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check": "npm run lint && npm run check:cloud && npm run check:abap2ui5 && npm run rename",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abap2UI5-addons/range-filter.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/abap2UI5-addons/range-filter/issues"
  },
  "homepage": "https://github.com/abap2UI5-addons/range-filter#readme",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.5",
    "@abap2ui5/linter-render": "^0.8.5",
    "@abaplint/cli": "^2.120.75",
    "@abaplint/database-sqlite": "^2.13.83",
    "@abaplint/runtime": "^2.14.3",
    "@abaplint/transpiler-cli": "^2.14.3",
    "@types/node": "^22.20.5",
    "npm-check-updates": "^23.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
